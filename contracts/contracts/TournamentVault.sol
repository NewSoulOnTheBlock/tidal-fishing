pragma solidity ^0.8.24;
import './Common.sol';
contract TournamentVault is OwnableLite { using SafeERC20Lite for IERC20Lite; IERC20Lite public immutable asset; address public operatorTreasury; address public reserve; address public sponsor; uint16 public prizeBps=7000; uint16 public operatorBps=2000; uint16 public reserveBps=500; uint16 public sponsorBps=500; mapping(uint256=>uint256) public prizePools; event TournamentEntered(address indexed player,uint256 indexed tournamentId,uint256 entryFee); constructor(IERC20Lite asset_,address operator_,address reserve_,address sponsor_){asset=asset_;operatorTreasury=operator_;reserve=reserve_;sponsor=sponsor_;} function enter(uint256 tournamentId,uint256 entryFee) external { require(entryFee>0,'fee=0'); asset.safeTransferFrom(msg.sender,address(this),entryFee*prizeBps/10000); asset.safeTransferFrom(msg.sender,operatorTreasury,entryFee*operatorBps/10000); asset.safeTransferFrom(msg.sender,reserve,entryFee*reserveBps/10000); asset.safeTransferFrom(msg.sender,sponsor,entryFee*sponsorBps/10000); prizePools[tournamentId]+=entryFee*prizeBps/10000; emit TournamentEntered(msg.sender,tournamentId,entryFee); } }
