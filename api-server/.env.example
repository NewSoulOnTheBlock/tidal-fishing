# Bull Fish Blitz API / Robinhood Chain runtime configuration
# Never commit real private keys or live secrets.

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://www.bullfishblitz.com

# Persistence. Use Render internal DATABASE_URL in production.
DATABASE_URL=
PGSSLMODE=require

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
GAME_TOKEN_ADDRESS=0x6E6e926AAEC6dCD0EDBD49CfC5BC49062Ae80923
GAME_TOKEN_SYMBOL=TIDAL
GAME_TOKEN_DECIMALS=18
BAIT_STORE_ADDRESS=0x9b899e09429750a75BF0a492593b11E42a77Cb0E
REWARD_ESCROW_ADDRESS=0xe5Fa543D9DfF6c3c8deE59A9406896d5470781dA
HOUSE_RESERVE_VAULT_ADDRESS=0xab291894E18f083F45E0fD951b939F5bbaEB5e5a
TOURNAMENT_VAULT_ADDRESS=0xb056A7938E97614Ef30a9C3A850e9c0F0Df643EB
SPONSORED_HOTSPOTS_ADDRESS=0xD84bF6567d1D720c5af49b173fa9B6a0f2204dee
OPERATOR_TREASURY=0x793a5e8b8Ff431cC2D8eE41e8ec2D9ad70247E60

# Server-side only. Use a rotated/fresh reward signer key in production.
REWARD_SIGNER_PRIVATE_KEY=
ADMIN_SECRET=

# Risk controls
REWARD_POOL_BALANCE_UI=0
ACCOUNT_SUSPENSION_ENABLED=false

# Optional gacha/raffle legacy integrations, disabled unless configured.
GACHA_API_KEY=
GACHA_API_BASE=https://gacha.collectorcrypt.com
RAFFLE_DEFAULT_PACK=pokemon_50
RAFFLE_DEFAULT_PACK_NAME=Elite Pack
RAFFLE_DEFAULT_PACK_PRICE=50
RAFFLE_DURATION_HOURS=24
RAFFLE_TICK_MS=300000
RAFFLE_AUTO_FULFILL=false
