# Bull Fish Blitz API / Robinhood Chain runtime configuration
# Never commit real private keys or live secrets.

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://www.bullfishblitz.com

# Persistence. Use Render internal DATABASE_URL in production.
DATABASE_URL=
PGSSLMODE=require

# Robinhood Chain
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
GAME_TOKEN_ADDRESS=0xcf987e5ec08229eb9cf260f66d3382c827e37777
GAME_TOKEN_SYMBOL=USDG
GAME_TOKEN_DECIMALS=18
BAIT_STORE_ADDRESS=0x760b0b30a69763516dD46167F9a6211Ed172cc35
REWARD_ESCROW_ADDRESS=0xCe81b8730D897Bf4B3581C541a9A3B788402E565
HOUSE_RESERVE_VAULT_ADDRESS=0xf6F25BC8E234C5a58B791fbF22cBA2D43AffB67f
TOURNAMENT_VAULT_ADDRESS=0x484fF0082f2F3B2a185423848d2927B3fA765ECd
SPONSORED_HOTSPOTS_ADDRESS=0x54be4CCe1641B802aD4A410227873d1b9F3859E4
OPERATOR_TREASURY=0x793a5e8b8Ff431cC2D8eE41e8ec2D9ad70247E60

# Server-side only. Use a rotated/fresh reward signer key in production.
REWARD_SIGNER_PRIVATE_KEY=
ADMIN_SECRET=

# Risk controls
REWARD_POOL_BALANCE_UI=0
ACCOUNT_SUSPENSION_ENABLED=false

# Optional gacha/raffle legacy integrations, disabled unless configured.
GACHA_API_KEY=
